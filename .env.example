# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Encryption key for storing broker tokens (32 bytes, base64)
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=your_base64_encryption_key

# AI Provider: openai | openrouter | claude | yandex
AI_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...
# Examples: openai/gpt-4o, anthropic/claude-sonnet-4, google/gemini-2.5-flash
OPENROUTER_MODEL=openai/gpt-4o

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# YandexGPT
YANDEX_API_KEY=your_yandex_api_key
YANDEX_FOLDER_ID=your_folder_id
YANDEX_MODEL=yandexgpt

# Database path (SQLite)
# Local:  ./data/investment.db
# Docker: /app/data/investment.db (set automatically in docker-compose.yml)
DB_PATH=./data/investment.db

# T-Bank API endpoint (host:port only — NOT your API token!)
# Token is entered in Telegram via /connect, never put it here.
TBANK_ENDPOINT=invest-public-api.tinkoff.ru:443

# Skip TLS certificate verify for T-Bank gRPC (needed on some VPS/Docker images)
# Set to false only if system CA bundle trusts T-Bank certs
TBANK_TLS_INSECURE=true

# Timezone for daily digest (IANA), e.g. Europe/Amsterdam, Europe/Berlin
TZ=UTC

# Scheduler: daily digest hour (0-23, container local time / TZ)
DIGEST_HOUR=9

# Proxy for Telegram API
# On a foreign VPS (EU/US) leave EMPTY — Telegram works without VPN
# Local PC in Russia (via NekoRay/Clash):
#   PROXY_URL=socks5://127.0.0.1:2080
PROXY_URL=
